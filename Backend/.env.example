# Copy to Backend/.env and fill in. Never commit .env.
# Real environment variables override values in this file.
ENVIRONMENT=development
DEBUG=false

# Project URL. Format is always https://<project-ref>.supabase.co
# (Settings -> API, or read the project ref from your dashboard address bar).
SUPABASE_URL=https://<project-ref>.supabase.co

# Postgres connection string. Supabase does not label this "Database URL":
# click the "Connect" button at the top of your project dashboard, choose
# "Session pooler", and copy the URI. Paste it as-is; a postgres:// or
# postgresql:// prefix is rewritten to postgresql+asyncpg:// by the app.
#  - [YOUR-PASSWORD] is the DATABASE password you set when creating the
#    project (not your Supabase account password; reset it in Database settings).
#  - URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# JSON array. Only needed for Expo web; native apps ignore CORS.
CORS_ORIGINS=["http://localhost:8081"]

# NOTE: no Supabase API key is needed yet. This backend verifies tokens via
# the public JWKS and reaches Postgres through DATABASE_URL. If you later call
# Supabase APIs (Auth admin, Storage) from here, add the SECRET key
# (sb_secret_..., Settings -> API Keys). Never put it in the Expo app.
