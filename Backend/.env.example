# Copy to Backend/.env and fill in. Never commit .env.
# Real environment variables override values in this file.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# true = one JSON object per log line; false = plain text (nicer locally)
LOG_JSON=true

# ---------------------------------------------------------------- database
# Supabase: "Connect" button -> pick the pooler below -> copy the URI.
# Which connection (see Backend/README.md, "Which Supabase connection"):
#  - DEPLOYED backend (one server, e.g. the demo or production): SESSION pooler (port 5432 on
#    the pooler host) or the direct connection. Prepared statements work there, so each query
#    is one network round trip; measured, CRUD calls take about half the time of the
#    transaction pooler.
#  - SHARED DEV project (several laptops each running a backend): TRANSACTION pooler (port
#    6543). The session pooler allows only a few clients per project in total, and once they
#    are taken every request fails ("max clients reached in session mode"). Supabase's
#    transaction mode has no prepared statements, so each query costs two round trips.
# Port 6543 is detected automatically (prepared-statement caching is turned off for it);
# override with DB_POOLER_MODE. A postgres:// or postgresql:// prefix is rewritten to
# postgresql+asyncpg://.
#  - <db-password> is the DATABASE password (Database settings), URL-encoded
#    (e.g. @ -> %40).
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
# Deployed backend (session pooler, same host, port 5432):
# DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# auto | session | transaction
DB_POOLER_MODE=auto
# Every running backend takes up to DB_POOL_SIZE + DB_MAX_OVERFLOW connections.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# Separate pool for the rules engine and presence passes (adds to the connections above).
BACKGROUND_DB_POOL_SIZE=1
BACKGROUND_DB_MAX_OVERFLOW=1
# Seconds a request waits for a free connection before answering 503 (busy)
DB_POOL_TIMEOUT_SECONDS=10
# Connections opened at startup
DB_POOL_WARM_CONNECTIONS=1
DB_POOL_WARM_TIMEOUT_SECONDS=15
DB_CONNECT_TIMEOUT_SECONDS=10
# Milliseconds a statement waits for a row lock before failing with 503 (empty = no limit).
# Sent as a connection parameter, but NOT through the transaction pooler (6543), which may refuse
# startup parameters: there, set it once on the database role instead, e.g.
#   ALTER ROLE <db-user> SET lock_timeout = '5s';
DB_LOCK_TIMEOUT_MS=5000
# Retry-After (seconds) on 503 SERVICE_UNAVAILABLE
DB_UNAVAILABLE_RETRY_AFTER_SECONDS=5
# A query running longer than this is cancelled
DB_COMMAND_TIMEOUT_SECONDS=30
DB_USE_NULL_POOL=false
# true = three extra DB round trips per session checkout (BEGIN, "SELECT ;",
# ROLLBACK) on every request and every background pass. Off by default here;
# DB_POOL_RECYCLE_SECONDS replaces idle connections before the pooler drops them.
# Set DB_POOL_PRE_PING=true if you see "connection was closed" errors.
DB_POOL_PRE_PING=false
# -1 = never recycle pooled connections
DB_POOL_RECYCLE_SECONDS=300

# Only for running pytest: a SEPARATE, disposable Postgres database whose name
# contains "test". The test suite DROPS AND RECREATES its public schema.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pillcare_test

# JSON array. Only needed for Expo web; native apps ignore CORS.
CORS_ORIGINS=["http://localhost:8081"]
# Request bodies above this are refused with 413 PAYLOAD_TOO_LARGE before parsing.
MAX_REQUEST_BODY_BYTES=1048576

# ---------------------------------------------------------------- caregiver auth
# app_jwt  = verify the access tokens issued by the Mobile server (what the
#            Expo app sends today). JWT_ACCESS_SECRET must be the SAME value as
#            JWT_ACCESS_SECRET in Mobile/.env.
# supabase = verify Supabase Auth tokens via JWKS (needs SUPABASE_URL).
AUTH_MODE=app_jwt
JWT_ACCESS_SECRET=
# Seconds a verified token's user is reused without a DB lookup (0 = every request)
AUTH_USER_CACHE_SECONDS=30
AUTH_USER_CACHE_MAX_ENTRIES=10000
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------- devices
# Enables POST /api/v1/admin/devices (factory provisioning of devices).
# Leave empty to disable. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROVISIONING_TOKEN=
# Minimum length of a custom device secret at provisioning. Generated secrets
# are 43 chars. Lower it only for local demos.
DEVICE_SECRET_MIN_LENGTH=16

# ---------------------------------------------------------------- presence
DEVICE_HEARTBEAT_INTERVAL_SECONDS=15
# No heartbeat for this long -> device OFFLINE (3 missed beats at 15 s)
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=45
PRESENCE_CHECK_INTERVAL_SECONDS=5
# Minimum offline duration before a DEVICE_OFFLINE notification is written
DEVICE_OFFLINE_NOTIFY_GRACE_SECONDS=120
WS_AUTH_TIMEOUT_SECONDS=10
# /ws/app: slow sockets are dropped after this; unchanged device statuses are pushed at most this often
APP_WS_SEND_TIMEOUT_SECONDS=5
APP_WS_DEVICE_PUSH_MIN_INTERVAL_SECONDS=60
COMMAND_ACK_TIMEOUT_SECONDS=10
# /ws/device: a send or close slower than this drops the socket (a stalled pillbox cannot hang requests).
DEVICE_WS_SEND_TIMEOUT_SECONDS=5
# Recent device commands kept in memory for diagnostics.
DEVICE_COMMAND_HISTORY_SIZE=200

# ---------------------------------------------------------------- rules engine
RULES_ENGINE_INTERVAL_SECONDS=30
RULES_ENGINE_LOOKBACK_DAYS=1
# Schedules materialized between event-loop yields; PENDING doses decided per transaction.
RULES_ENGINE_YIELD_EVERY_SCHEDULES=500
RULES_ENGINE_DECIDE_CHUNK_SIZE=500
MISSED_DECISION_GRACE_SECONDS=60
OFFLINE_FLUSH_WAIT_SECONDS=60
OFFLINE_MAX_WAIT_MINUTES=360
DOSE_EARLY_ACCEPT_MINUTES=15
# A dose taken up to this many whole minutes after window_end is still ON TIME (DOSE_TAKEN, delay 0),
# so a short delay by the elderly person is not reported as "Terlambat". 0 = strict.
ON_TIME_GRACE_MINUTES=10
ENABLE_BACKGROUND_TASKS=true
# A failing background pass waits interval * 2^failures (exponent and seconds capped).
BACKGROUND_MAX_BACKOFF_EXPONENT=4
BACKGROUND_MAX_BACKOFF_SECONDS=300
# /health says "degraded" when a loop finished no pass for this many of its intervals.
BACKGROUND_STALE_AFTER_INTERVALS=4

# ---------------------------------------------------------------- telemetry & thresholds
TELEMETRY_MAX_BATCH_SIZE=500
TELEMETRY_MAX_FUTURE_SKEW_MINUTES=10080
TELEMETRY_MAX_PAST_SKEW_MINUTES=10080
# A buffered BATTERY_STATUS older than this many heartbeat intervals does not overwrite a fresher heartbeat.
TELEMETRY_FRESH_HEARTBEAT_INTERVALS=2
LOW_BATTERY_THRESHOLD_PERCENT=20
# Battery must rise this far above the threshold before LOW_BATTERY can fire again
LOW_BATTERY_HYSTERESIS_PERCENT=5
# Wi-Fi label in GET /devices/{id}/status: >= strong = KUAT, >= medium = SEDANG, else LEMAH
WIFI_RSSI_STRONG_DBM=-60
WIFI_RSSI_MEDIUM_DBM=-75
LOW_STOCK_THRESHOLD_UNITS=3
# Unchanged heartbeat stock counts are rewritten at least this often (seconds)
STOCK_CACHE_REWRITE_SECONDS=300
STOCK_CAPACITY_PER_SLOT=30
CLOCK_DRIFT_TOLERANCE_SECONDS=60
# Judge doses and show the app's day by the device clock (heartbeat rtc_time + rtc_speed), so the
# emulator's lab clock (+1 hour, 60x) is followed by the backend and the app. Needs migration 0004.
FOLLOW_DEVICE_CLOCK=true
# The device clock is followed only within this many minutes of server time; outside it, server time.
DEVICE_CLOCK_MAX_SKEW_MINUTES=10080
# Rated runtime of a full battery in days; empty = battery-days estimate is null
BATTERY_RATED_DAYS=
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=300
# PIN attempts are counted per device across all users (attempt_counters table).
# POST /pairing/scan calls allowed per user per window.
PAIRING_SCAN_MAX_ATTEMPTS=30
PAIRING_SCAN_WINDOW_SECONDS=300
# Days searched for the next dose that bounds a late release.
LATE_RELEASE_LOOKAHEAD_DAYS=2

# Device timezone used at pairing when neither the request nor the caregiver profile has one
DEFAULT_DEVICE_TIMEZONE=Asia/Jakarta

DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
# GET /elderly/{id}/journal/summary: longest period per request.
JOURNAL_MAX_SUMMARY_DAYS=366

# Elderly profile validation
ELDERLY_MAX_AGE_YEARS=120
ELDERLY_NAME_MIN_LENGTH=2

# ---------------------------------------------------------------- measurement
# true = log "perf_timing" lines (flow, step, correlation_id, *_ms). No secrets or names.
PERF_TIMING_LOGS=false
