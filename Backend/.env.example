# Copy to Backend/.env and fill in. Never commit .env.
# Real environment variables override values in this file.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# true = one JSON object per log line; false = plain text (nicer locally)
LOG_JSON=true

# ---------------------------------------------------------------- database
# Supabase: "Connect" button -> "Transaction pooler" (port 6543) -> copy the URI.
# Use the TRANSACTION pooler when several people run the backend against the same
# Supabase project: the session pooler (port 5432) allows only a few clients per
# project in total, and once they are taken every login/request fails
# ("max clients reached in session mode"). Port 6543 is detected automatically
# (prepared-statement caching is turned off for it); override with DB_POOLER_MODE.
# A postgres:// or postgresql:// prefix is rewritten to postgresql+asyncpg://.
#  - <db-password> is the DATABASE password (Database settings), URL-encoded
#    (e.g. @ -> %40).
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
# auto | session | transaction
DB_POOLER_MODE=auto
# Every running backend takes up to DB_POOL_SIZE + DB_MAX_OVERFLOW connections.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# Seconds a request waits for a free connection before answering 503 (busy)
DB_POOL_TIMEOUT_SECONDS=10
# Connections opened at startup
DB_POOL_WARM_CONNECTIONS=1
DB_CONNECT_TIMEOUT_SECONDS=10
# A query running longer than this is cancelled
DB_COMMAND_TIMEOUT_SECONDS=30
DB_USE_NULL_POOL=false
# true = three extra DB round trips per session checkout (BEGIN, "SELECT ;",
# ROLLBACK) on every request and every background pass. Off by default here;
# DB_POOL_RECYCLE_SECONDS replaces idle connections before the pooler drops them.
# Set DB_POOL_PRE_PING=true if you see "connection was closed" errors.
DB_POOL_PRE_PING=false
# -1 = never recycle pooled connections
DB_POOL_RECYCLE_SECONDS=300

# Only for running pytest: a SEPARATE, disposable Postgres database whose name
# contains "test". The test suite DROPS AND RECREATES its public schema.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pillcare_test

# JSON array. Only needed for Expo web; native apps ignore CORS.
CORS_ORIGINS=["http://localhost:8081"]

# ---------------------------------------------------------------- caregiver auth
# app_jwt  = verify the access tokens issued by the Mobile server (what the
#            Expo app sends today). JWT_ACCESS_SECRET must be the SAME value as
#            JWT_ACCESS_SECRET in Mobile/.env.
# supabase = verify Supabase Auth tokens via JWKS (needs SUPABASE_URL).
AUTH_MODE=app_jwt
JWT_ACCESS_SECRET=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------- devices
# Enables POST /api/v1/admin/devices (factory provisioning of devices).
# Leave empty to disable. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROVISIONING_TOKEN=
# Minimum length of a custom device secret at provisioning. Generated secrets
# are 43 chars. Lower it only for local demos.
DEVICE_SECRET_MIN_LENGTH=16

# ---------------------------------------------------------------- presence
DEVICE_HEARTBEAT_INTERVAL_SECONDS=15
# No heartbeat for this long -> device OFFLINE (3 missed beats at 15 s)
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=45
PRESENCE_CHECK_INTERVAL_SECONDS=5
# Minimum offline duration before a DEVICE_OFFLINE notification is written
DEVICE_OFFLINE_NOTIFY_GRACE_SECONDS=120
WS_AUTH_TIMEOUT_SECONDS=10
COMMAND_ACK_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- rules engine
RULES_ENGINE_INTERVAL_SECONDS=30
RULES_ENGINE_LOOKBACK_DAYS=1
MISSED_DECISION_GRACE_SECONDS=60
OFFLINE_FLUSH_WAIT_SECONDS=60
OFFLINE_MAX_WAIT_MINUTES=360
DOSE_EARLY_ACCEPT_MINUTES=15
# A dose taken up to this many whole minutes after window_end is still ON TIME (DOSE_TAKEN, delay 0),
# so a short delay by the elderly person is not reported as "Terlambat". 0 = strict.
ON_TIME_GRACE_MINUTES=10
ENABLE_BACKGROUND_TASKS=true

# ---------------------------------------------------------------- telemetry & thresholds
TELEMETRY_MAX_BATCH_SIZE=500
TELEMETRY_MAX_FUTURE_SKEW_MINUTES=10080
LOW_BATTERY_THRESHOLD_PERCENT=20
# Battery must rise this far above the threshold before LOW_BATTERY can fire again
LOW_BATTERY_HYSTERESIS_PERCENT=5
# Wi-Fi label in GET /devices/{id}/status: >= strong = KUAT, >= medium = SEDANG, else LEMAH
WIFI_RSSI_STRONG_DBM=-60
WIFI_RSSI_MEDIUM_DBM=-75
LOW_STOCK_THRESHOLD_UNITS=3
STOCK_CAPACITY_PER_SLOT=30
CLOCK_DRIFT_TOLERANCE_SECONDS=60
# Judge doses and show the app's day by the device clock (heartbeat rtc_time + rtc_speed), so the
# emulator's lab clock (+1 hour, 60x) is followed by the backend and the app. Needs migration 0004.
FOLLOW_DEVICE_CLOCK=true
# Rated runtime of a full battery in days; empty = battery-days estimate is null
BATTERY_RATED_DAYS=
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=300

# Device timezone used at pairing when neither the request nor the caregiver profile has one
DEFAULT_DEVICE_TIMEZONE=Asia/Jakarta

DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# ---------------------------------------------------------------- measurement
# true = log "perf_timing" lines (flow, step, correlation_id, *_ms). No secrets or names.
PERF_TIMING_LOGS=false
