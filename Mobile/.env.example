# ---------- Required ----------
# Postgres via Supabase pooler (Prisma).
# Use the TRANSACTION pooler (6543, ?pgbouncer=true): it is shared by everyone running the
# app against this Supabase project. The session pooler (5432) allows only a few clients per
# project in total; when teammates run the server at the same time it fills up and logins fail.
# Keep connection_limit small: every running server takes up to that many connections.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=10&connect_timeout=10"
# Migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Signs our own access tokens. >= 32 random chars (e.g. `openssl rand -base64 48`). Server-only.
JWT_ACCESS_SECRET=

# Supabase project (Dashboard > Project Settings > API Keys). URL + publishable key are safe in the app.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# ---------- Needed only for Google sign-in (and deleting Google-linked accounts) ----------
# Secret key (sb_secret_...). Server-only, never prefix with EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ---------- Optional ----------
# Where the app reaches the API. Not needed on web (same origin). On a phone use your LAN IP, e.g. http://192.168.1.10:8081
EXPO_PUBLIC_API_URL=
# FastAPI pillbox backend (Backend/). Unset = the dashboard uses mock data.
# "auto" = same machine that serves the app, port 8000 ("auto:9000" for another port): keeps
# working when your Wi-Fi IP changes. Or a fixed URL, e.g. http://192.168.1.10:8000
EXPO_PUBLIC_PILLBOX_API_URL=
# Optional: pillbox (device UUID) to select first when the app has no saved choice yet.
# The app remembers the pillbox picked in its switcher per account; this is only the fallback.
EXPO_PUBLIC_PILLBOX_DEVICE_ID=
# Tuning (all optional; defaults shown). Public values: they are inlined into the app bundle.
# Abort any API request after this many ms (keep above the backend's COMMAND_ACK_TIMEOUT_SECONDS)
EXPO_PUBLIC_API_TIMEOUT_MS=20000
# Notification feed polling: the worst-case extra delay before a new alert shows up
EXPO_PUBLIC_NOTIFICATION_POLL_MS=5000
EXPO_PUBLIC_NOTIFICATION_PAGE_SIZE=50
EXPO_PUBLIC_DEVICE_STATUS_POLL_MS=10000
# Keep equal to the backend's STOCK_CAPACITY_PER_SLOT
EXPO_PUBLIC_SLOT_CAPACITY=30
# Placeholder number for the dashboard "call" button
EXPO_PUBLIC_ELDER_PHONE=
# Measurement: "[perf]" lines in the Metro/device log (app side) and the dev-server log (API routes)
EXPO_PUBLIC_PERF_TIMING_LOGS=false
PERF_TIMING_LOGS=false
# Unset in dev: OTP codes are printed to the server console and .dev-last-otp.json.
# Without a verified domain use EMAIL_FROM=onboarding@resend.dev: Resend then only delivers to the
# email you signed up to Resend with. In dev, rejected sends fall back to the console automatically.
RESEND_API_KEY=
EMAIL_FROM=
# Separate OTP hashing key; derived from JWT_ACCESS_SECRET when unset
OTP_PEPPER=
