generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @db.Uuid // Primary key matching Supabase auth.users(id)
  fullName          String?   @map("full_name") @db.VarChar
  email             String    @unique @db.VarChar
  phoneNumber       String?   @map("phone_number") @db.VarChar
  timezone          String?   @db.VarChar
  googleLinked      Boolean?  @default(false) @map("google_linked")
  interfaceLanguage String?   @default("id") @map("interface_language") @db.VarChar
  displayMode       String?   @default("light") @map("display_mode") @db.VarChar
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("users") // Maps this Prisma model to the "public.users" table
}
