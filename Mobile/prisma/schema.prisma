generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InterfaceLanguage {
  ID
  EN

  @@map("interface_language")
}

enum DisplayMode {
  LIGHT
  DARK

  @@map("display_mode")
}

enum AuthProvider {
  GOOGLE

  @@map("auth_provider")
}

enum PushPlatform {
  ANDROID
  IOS

  @@map("push_platform")
}

model User {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName          String            @map("full_name") @db.VarChar
  email             String            @unique @db.VarChar // always stored lowercase
  passwordHash      String?           @map("password_hash") @db.VarChar // null for Google-only accounts
  phoneNumber       String?           @map("phone_number") @db.VarChar // E.164
  timezone          String            @default("Asia/Jakarta") @db.VarChar // IANA
  interfaceLanguage InterfaceLanguage @default(ID) @map("interface_language")
  displayMode       DisplayMode       @default(LIGHT) @map("display_mode")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities        AuthIdentity[]
  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]
  pushTokens        PushToken[]

  @@map("users") // Maps this Prisma model to the "public.users" table
}

model AuthIdentity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar
  supabaseUserId String?      @map("supabase_user_id") @db.Uuid
  email          String       @db.VarChar
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar // SHA-256 hex
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetOtp {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.VarChar // HMAC-SHA256(OTP_PEPPER)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_otps")
}

model PushToken {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  token       String       @unique @db.VarChar
  platform    PushPlatform
  deviceLabel String?      @map("device_label") @db.VarChar
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}
