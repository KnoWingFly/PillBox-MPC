{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "Mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081,
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    },
    {
      "name": "backend",
      "runtimeExecutable": "Backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "Backend", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"],
      "port": 8000,
      "autoPort": false
    }
  ]
}